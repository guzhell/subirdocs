{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subirdocs",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "mstrpln-acta-docs" }
  ],
  "observability": { "enabled": true }
}
